# Copie ce fichier dans .env pour configurer les services réels.
# Les réglages enregistrés dans l’application priment sur ces valeurs initiales.

# Facultatif. simulated (défaut) ou live (activation explicite).
FAAALL_SMS_MODE=simulated

# Paramètres Twilio requis uniquement en mode live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio et numéro du proche au format international E.164.
TWILIO_FROM_NUMBER=
FAAALL_SMS_TO_NUMBER=

# Requis pour enregistrer les alertes réelles. Saisissables aussi dans Réglages.
FAAALL_MONITORED_FIRST_NAME=
FAAALL_ALERT_ADDRESS=
FAAALL_CONTACT_NAME=

# Requis seulement pour interpréter les réponses avec OpenRouter.
# Le fournisseur reçoit le texte utile du SMS associé, avec les coordonnées
# connues masquées. Aucun média ni identifiant d’incident n’est transmis.
OPENROUTER_API_KEY=
# Facultatif. Le modèle doit accepter les sorties JSON Schema strictes.
OPENROUTER_MODEL=openai/gpt-4o-mini
