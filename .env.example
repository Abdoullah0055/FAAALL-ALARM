# Copie ce fichier dans .env pour configurer les services réels.
# Les réglages enregistrés dans l’application priment sur ces valeurs initiales.

# Facultatif. simulated (défaut), live (Twilio) ou telegram (activation explicite).
FAAALL_SMS_MODE=telegram

# Paramètres Twilio requis uniquement en mode live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio et numéro du proche au format international E.164.
TWILIO_FROM_NUMBER=
FAAALL_SMS_TO_NUMBER=

# Requis pour Telegram. Jeton d’un bot dédié créé avec @BotFather.
TELEGRAM_BOT_TOKEN=

# Requis pour enregistrer les alertes réelles. Saisissables aussi dans Réglages.
FAAALL_MONITORED_FIRST_NAME=
FAAALL_ALERT_ADDRESS=
FAAALL_CONTACT_NAME=

# Requis seulement pour l’interprétation réelle. Clé créée sur platform.openai.com.
# Le fournisseur reçoit le texte utile du SMS associé, avec les coordonnées
# connues masquées. Aucun média ni identifiant d’incident n’est transmis.
OPENAI_API_KEY=
# Facultatif. Le modèle doit accepter JSON Schema strict et reasoning.effort=none.
OPENAI_MODEL=gpt-6-luna


# Notes d’intégration : l’application lit FAAALL_SMS_MODE, FAAALL_MONITORED_FIRST_NAME,
# FAAALL_ALERT_ADDRESS, FAAALL_CONTACT_NAME, FAAALL_SMS_TO_NUMBER et TWILIO_FROM_NUMBER comme valeurs initiales.
# Les réglages enregistrés (config.local.json, ignoré par Git) priment. Les secrets Twilio et OpenAI
# ne sont jamais écrits dans ce fichier local de réglages. Le mode réel exige FAAALL_SMS_MODE=live, une
# activation explicite et une vraie webcam : la lecture MP4, la démo et les tests restent simulés.
