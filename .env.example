# Modèle de configuration pour le futur module SMS.
# Copie ce fichier dans .env et remplis uniquement la copie locale.
# Ces variables sont prévues par le projet. L’application ne les lit pas encore.

# Mode par défaut sans envoi réel. Valeurs prévues : simulated ou live.
FAAALL_SMS_MODE=simulated

# Paramètres Twilio requis uniquement en mode live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio et numéro du proche au format international E.164.
TWILIO_FROM_NUMBER=
FAAALL_SMS_TO_NUMBER=

# Informations utilisées pour rédiger le SMS d’alerte.
# Valeurs nécessaires en mode live. Utiliser des données fictives dans les tests.
FAAALL_MONITORED_FIRST_NAME=
FAAALL_ALERT_ADDRESS=

# OpenRouter, requis uniquement pour interpréter les réponses avec un modèle réel.
# Garde la clé dans .env. Modèle au format fournisseur/nom-du-modele.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
