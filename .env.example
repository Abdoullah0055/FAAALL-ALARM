# Modèle de configuration. Copie ce fichier dans .env et remplis uniquement la copie locale.
# L'application (faaall_alarm.config.read_config) lit FAAALL_SMS_MODE, FAAALL_MONITORED_FIRST_NAME,
# FAAALL_ALERT_ADDRESS, FAAALL_SMS_TO_NUMBER et TWILIO_FROM_NUMBER. Les valeurs enregistrées depuis
# la page Réglages (config.local.json, ignoré par Git) les remplacent. Les secrets Twilio et OpenRouter
# ne sont lus que par le module SMS et l'interpréteur (lot Abdoullah), jamais écrits dans config.local.json.
# Le mode réel exige FAAALL_SMS_MODE=live ET l'activation explicite dans les réglages ; la lecture MP4,
# la démo et les tests restent simulés quelle que soit cette configuration.

# Mode par défaut sans envoi réel. Valeurs prévues : simulated ou live.
FAAALL_SMS_MODE=simulated

# Paramètres Twilio requis uniquement en mode live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numéro Twilio et numéro du proche au format international E.164.
TWILIO_FROM_NUMBER=
FAAALL_SMS_TO_NUMBER=

# Informations utilisées pour rédiger le SMS d’alerte.
# Valeurs nécessaires en mode live. Utiliser des données fictives dans les tests.
FAAALL_MONITORED_FIRST_NAME=
FAAALL_ALERT_ADDRESS=

# OpenRouter, requis uniquement pour interpréter les réponses avec un modèle réel.
# Garde la clé dans .env. Modèle au format fournisseur/nom-du-modele.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
